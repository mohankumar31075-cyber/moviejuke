  "description": "Knowledge Bank — curriculum companion for Pre-Nursery to Class 5 (CBSE / ICSE / State / Generic) with quizzes, live multiplayer, certificates, parent & teacher dashboards and CMS.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:server\" \"npm:client\"",
